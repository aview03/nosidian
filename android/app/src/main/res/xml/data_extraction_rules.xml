<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : 클라우드 백업과 기기 간 전송에서 보안 저장소를 제외한다 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nosidian_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nosidian_secure.xml" />
    </device-transfer>
</data-extraction-rules>
